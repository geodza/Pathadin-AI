# Copy to .env. Keys are read only by the local backend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional comma-separated exact model IDs. Select image-capable models available to your account.
OPENAI_MODELS=
ANTHROPIC_MODELS=
GEMINI_MODELS=
# Optional native OpenSlide DLL directory on Windows:
OPENSLIDE_PATH=
# Optional location for saved data (defaults to the local data folder):
# PATHADINAI_DATA=C:/PathadinData
